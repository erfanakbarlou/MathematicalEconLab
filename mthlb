cards{grid-template-columns:1fr}.card{display:grid;grid-template-columns:1fr 1fr;gap:10px}.card\u003eh3,.card\u003e.formula,.card\u003ep{grid-column:1/-1}.mini{border:0;margin:0;padding:0}.plot{height:400px}}@media(max-width:480px){main{padding:20px 12px}.workspace,aside{padding:16px}.point{display:block;width:100%}.point+.point{margin-left:0}.metric{padding:8px}.metric span{font-size:12px}.metric strong{font-size:20px}.plot{height:340px}nav{gap:14px;font-size:14px}.status{align-items:flex-start}}\r\n\u003c/style\u003e\u003cstyle\u003e.mode-switch{max-width:1232px;margin:20px auto 0;padding:0 24px;display:flex;gap:10px;flex-wrap:wrap}.mode-switch button[aria-pressed=\"true\"]{background:#ad9bff25;border-color:#ad9bff}.lp-frame{display:block;width:100%;border:0;min-height:600px}.lp-frame[hidden],body\u003emain[hidden]{display:none!important}\u003c/style\u003e\u003c/head\u003e\u003cbody\u003e\u003cdiv class=\"mode-switch\" role=\"group\" aria-label=\"Norm Lab section\"\u003e\u003cbutton id=\"classic-mode\" aria-pressed=\"true\" aria-controls=\"classic-view\"\u003eClassic norms\u003c/button\u003e\u003cbutton id=\"general-mode\" aria-pressed=\"false\" aria-controls=\"general-view\"\u003eGeneral Lp \u00b7 Custom p\u003c/button\u003e\u003c/div\u003e\u003cmain id=\"classic-view\"\u003e\u003cnav\u003e\u003cb\u003e\u25c8 \u0026nbsp; MATHLAB / NORM LAB\u003c/b\u003e\u003c/nav\u003e\u003cheader\u003e\u003cdiv class=\"eyebrow\"\u003eGeometry of distance\u003c/div\u003e\u003ch1\u003eOne space.\u003cbr\u003eThree ways to measure.\u003c/h1\u003e\u003cp class=\"lead\"\u003eMove two points. Switch the norm. Discover how Euclidean, sum and supremum distance give the same space a different geometry.\u003c/p\u003e\u003c/header\u003e\r\n\u003csection id=\"shapes\"\u003e\u003ch2\u003eThe classic unit shapes\u003c/h2\u003e\u003cp\u003eEvery boundary point satisfies \u2016x\u2016 = 1. The filled interior is the unit ball: \u2016x\u2016 \u2264 1.\u003c/p\u003e\u003cdiv class=\"cards\" id=\"cards\"\u003e\u003c/div\u003e\u003cp class=\"note\"\u003eA familiar example: from (0, 0) to (3, 4), Euclidean distance is 5, sum distance is 7, and sup distance is 4.\u003c/p\u003e\u003c/section\u003e\r\n\u003csection id=\"lab2\"\u003e\u003ch2\u003eExplore in two dimensions\u003c/h2\u003e\u003cp\u003eDrag A or B on the plane, or enter their coordinates. The selected ball is centered at A and passes through B.\u003c/p\u003e\u003cdiv class=\"lab\" id=\"two\"\u003e\u003c/div\u003e\u003c/section\u003e\r\n\u003csection id=\"lab3\"\u003e\u003ch2\u003eExplore in three dimensions\u003c/h2\u003e\u003cp\u003eChange the coordinates to move A and B. Drag the scene to orbit; scroll to zoom. Your viewing angle stays fixed as you change the norm or points.\u003c/p\u003e\u003cdiv class=\"lab\" id=\"three\"\u003e\u003c/div\u003e\u003c/section\u003e\u003cfooter\u003eDistance is d(A, B) = \u2016B \u2212 A\u2016. The straight segment joins the same two points for every norm; its norm-based length changes.\u003cbr\u003eDisplayed values are rounded; \u2248 marks approximate equality. Curved boundaries are sampled for drawing; distances are calculated from the norm formula.\u003c/footer\u003e\u003c/main\u003e\r\n\u003cscript\u003e\r\n'use strict';\r\nconst defs=[{id:'2',name:'Euclidean',short:'L\u2082',color:'#ad9bff',formula:'\u2016x\u2016\u2082 = \u221a(x\u2081\u00b2 + \u22ef + x\u2099\u00b2)',shape2:'Circle',shape3:'Sphere'}, {id:'1',name:'Sum',short:'L\u2081',color:'#56d9e8',formula:'\u2016x\u2016\u2081 = |x\u2081| + \u22ef + |x\u2099|',shape2:'Diamond',shape3:'Octahedron'}, {id:'inf',name:'Sup',short:'L\u221e',color:'#ffbb70',formula:'\u2016x\u2016\u221e = max(|x\u2081|, \u2026, |x\u2099|)',shape2:'Square',shape3:'Cube'}];\r\nconst fmt=n=\u003en===0?'0':Math.abs(n)\u003c0.001?Number(n.toPrecision(3)).toString():Number(n.toFixed(3)).toString();\r\nconst relation=n=\u003eNumber(fmt(n))===n?' = ':' \u2248 ';\r\nfunction norm(v,k){return k==='2'?Math.hypot(...v):k==='1'?v.reduce((s,x)=\u