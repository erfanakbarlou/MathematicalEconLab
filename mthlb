document.querySelectorAll(".fullscreen-toggle").forEach(button=>button.addEventListener("click",async()=>{const card=button.closest(".chart-card");if(document.fullscreenElement===card){await document.exitFullscreen()}else{await card.requestFullscreen()}}));
