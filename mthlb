append(row);}root.querySelector('.controls').append(box);}\\nfunction sync(){root.querySelectorAll('[data-key]').forEach(e=\u003ee.value=s[e.dataset.key][Number(e.dataset.axis)]);}\\nfunction draw(){const {g,w,h}=setup(c),d={color:'#ad9bff'},r=norm(s.b.map((x,i)=\u003ex-s.a[i]),s.k);const extent=drag?.extent ?? (s.ball?Math.max(6,...s.a.map(x=\u003eMath.abs(x)+r))*1.08:6);activeExtent=extent;project=dim===2?v=\u003e[w/2+v[0]*Math.min(w,h)*.43/extent,h/2-v[1]*Math.min(w,h)*.43/extent]:projection(w,h,extent,s.yaw,s.pitch,s.zoom);\\nif(dim===2){const step=extent\u003e12?4:extent\u003e7?2:1;for(let i=-Math.floor(extent/step)*step;i\\u003c=extent;i+=step){line(g,[project([i,-extent]),project([i,extent])],i===0?'#64748d':'#1b293d');line(g,[project([-extent,i]),project([extent,i])],i===0?'#64748d':'#1b293d');if(i!==0){text(g,fmt(i),[project([i,0])[0]+3,h/2+16]);text(g,fmt(i),[w/2+5,project([0,i])[1]-4]);}}text(g,'x',project([extent-.5,-.6]));text(g,'y',project([.3,extent-.5]));if(s.ball)ball2(g,s.k,s.a,r,project,d.color);\\n}else{for(let i=0;i\\u003c3;i++){let a=[0,0,0],b=[0,0,0];a[i]=-extent;b[i]=extent;line(g,[project(a),project(b)],['#657d9b','#657d9b','#657d9b'][i]);text(g,'xyz'[i],project(b));for(let t=-4;t\\u003c=4;t+=2){let q=[0,0,0];q[i]=t;text(g,String(t),project(q));}}if(s.ball\u0026\u0026r\u003e0)ball3(g,s.k,s.a,r,project,d.color);}\\nline(g,[project(s.a),project(s.b)],'#ffffff',3);for(const [key,color]of [['a','#56d9e8'],['b','#ffbb70']]){const p=project(s[key]);g.beginPath();g.arc(p[0],p[1],7,0,Math.PI*2);g.fillStyle=color;g.fill();g.strokeStyle='#08101c';g.lineWidth=2;g.stroke();text(g,key.toUpperCase()+' ('+s[key].map(fmt).join(', ')+')',[p[0]+11,p[1]+(key==='a'?-12:23)],color);}}\\nfunction update(){const delta=s.b.map((x,i)=\u003ex-s.a[i]),v=delta.map(Math.abs),pv=s.k==='inf'?'\u221e':s.k;root.querySelectorAll('[data-k]').forEach(b=\u003eb.setAttribute('aria-pressed',b.dataset.k===s.k));root.querySelector('.metrics').innerHTML=`\\u003cdiv class=\\\"metric active\\\"\u003e\\u003cspan\u003eSelected p\\u003c/span\u003e\\u003cstrong\u003e${pv}\\u003c/strong\u003e\\u003c/div\u003e\\u003cdiv class=\\\"metric active\\\"\u003e\\u003cspan\u003eLp distance\\u003c/span\u003e\\u003cstrong\u003e${fmt(norm(delta,s.k))}\\u003c/strong\u003e\\u003c/div\u003e\\u003cdiv class=\\\"metric\\\"\u003e\\u003cspan\u003eEuclidean distance\\u003c/span\u003e\\u003cstrong\u003e${fmt(norm(delta,'2'))}\\u003c/strong\u003e\\u003c/div\u003e`;root.querySelector('.calculation').textContent='d\u209a(A, B)'+(v.some(x=\u003eNumber(fmt(x))!==x)?' \u2248 ':' = ')+(s.k==='inf'?'max('+v.map(fmt).join(', ')+')':'('+v.map(x=\u003e'|'+fmt(x)+'|^'+pv).join(' + ')+')^(1/'+pv+')')+relation(norm(delta,s.k))+fmt(norm(delta,s.k));root.querySelector('.ballLegend').textContent=s.ball?'Boundary: d\u209a(A, X)'+relation(norm(delta,s.k))+fmt(norm(delta,s.k)):'';draw();}\\nconst pNumber=root.querySelector('.p-number'),pRange=root.querySelector('.p-range'),pError=root.querySelector('.p-error');let finiteP=2;\\nfunction setP(k){s.k=k;pError.textContent='';if(k!=='inf'){finiteP=Number(k);pNumber.value=k;pRange.value=Math.min(20,finiteP);}pNumber.disabled=k==='inf';pRange.disabled=k==='inf';update();}\\nroot.querySelectorAll('[data-k]').forEach(b=\u003eb.onclick=()=\u003esetP(b.dataset.k));\\npNumber.addEventListener('input',()=\u003e{const v=pNumber.valueAsNumber;if(!Number.isFinite(v)||v\\u003c1){pError.textContent='Enter a finite p greater than or equal to 1.';return;}finiteP=v;s.k=String(v);pRange.value=Math.min(20,v);pError.textContent='';update();});\\npNumber.addEventListener('change',()=\u003e{if(!Number.isFinite(pNumber.valueAsNumber)||pNumber.valueAsNumber\\u003c1){pNumber.value=finiteP;pError.textContent='';}});\\npRange.addEventListener('input',()=\u003esetP(String(pRange.valueAsNumber)));\\nroot.querySelector('[type=checkbox]').onchange=e=\u003e{s.ball=e.target.checked;update();};root.querySelector('.reset').onclick=()=\u003e{s.a=Array(dim).fill(0);s.b=dim===2?[3,4]:[2,3,4];sync();update();};let drag=null,frame=0;\\nfunction pos(e){const r=c.getBoundingClientRect();return [e.clientX-r.left,e.clientY-r.top];}\\nc.addEventListener('pointerdown',e=\u003e{const p=pos(e);if(dim===2){const closest=['a','b'].map(k=\u003e({k,d:Math.hypot(project(s[k])[0]-p[0],project(s[k])[1]-p[1])})).sort((a,b)=\u003ea.d-b.d)[0];if(closest.d\u003e25)return;const o=project([0,0]),u=project([1,0]);drag={key:closest.k,origin:o,scale:u[0]-o[0],extent:activeExtent};}else drag={p};c.setPointerCapture(e.pointerId);});\\nc.addEventListener('pointermove',e=\u003e{if(!drag)return;const p=pos(e);if(dim===2){s[drag.key]=[(p[0]-drag.origin[0])/drag.scale,(drag.origin[1]-p[1])/drag.scale].map(x=\u003eMath.round(Math.max(-5,Math.min(5,x))*10)/10);sync();}else{s.yaw+=(p[0]-drag.p[0])*.008;s.pitch=Math.max(-1.4,Math.min(1.4,s.pitch+(p[1]-drag.p[1])*.008));drag.p=p;}if(!frame)frame=requestAnimationFrame(()=\u003e{frame=0;update();});});\\nfor(const ev of ['pointerup','pointercancel','lostpointercapture'])c.addEventListener(ev,()=\u003e{drag=null;});if(dim===3)c.addEventListener('wheel',e=\u003e{e.preventDefault();s.zoom=Math.max(.5,Math.min(2.5,s.zoom*Math.exp(-e.deltaY*.001)));draw();},{passive:false});new ResizeObserver(draw).observe(c);update();return draw;}\\nconst redraw=[createLab('two',2),createLab('three',3)];\\n\\u003c/script\u003e\\u003c/body\u003e\\u003c/html\u003e\\n\"\u003c/script\u003e\u003cscript\u003e\r\n(()=\u003e{const classic=document.getElementById('classic-view'),frame=document.getElementById('general-view'),a=document.getElementById('classic-mode'),b=document.getElementById('general-mode');let ready=false;let resize;\r\nframe.addEventListener('load',()=\u003e{const main=frame.contentDocument.querySelector('main');if(!main)return;resize=new ResizeObserver(()=\u003e{frame.style.height=Math.ceil(main.getBoundingClientRect().height+4)+'px';});resize.observe(main);});\r\nfunction select(general){classic.hidden=general;frame.hidden=!general;a.setAttribute('aria-pressed',String(!general));b.setAttribute('aria-pressed',String(general));if(general\u0026\u0026!ready){ready=true;frame.srcdoc=JSON.parse(document.getElementById('general-source').textContent);}window.dispatchEvent(new Event('resize'));}\r\na.addEventListener('click',()=\u003eselect(false));b.addEventListener('click',()=\u003eselect(true));})();\r\n\u003c/script\u003e\u003c/body\u003e\u003c/html\u003e\r\n"</script>
<script>
const $ = id => document.getElementById(id);
const defaults = {
 cd:{A:1,alpha:.5,beta:.5}, ces:{A:1,delta:.5,rho:-.5}, subs:{a:2,b:3},
 comp:{a:2,b:3}, quad:{c0:0,c1:1,c2:1,c3:-.1,c4:-.1,c5:0}
};
let p = structuredClone(defaults.cd);
const specs = {
 cd:[['A','Scale factor A',.2,3,.1],['alpha','Output elasticity α',.1,2,.05],['beta','Output elasticity β',.1,2,.05]],
 ces:[['A','Scale factor A',.2,3,.1],['delta','Distribution parameter δ',.05,.95,.05],['rho','Substitution parameter ρ',-2,2,.1]],
 subs:[['a','Weight a',.2,5,.1],['b','Weight b',.2,5,.1]],
 comp:[['a','Weight a',.2,5,.1],['b','Weight b',.2,5,.1]],
 quad:[['c0','Constant c₀',-5,5,.5],['c1','Linear x · c₁',-3,3,.2],['c2','Linear y · c₂',-3,3,.2],['c3','Squared x · c₃',-1,1,.05],['c4','Squared y · c₄',-1,1,.05],['c5','Cross term · c₅',-1,1,.05]]
};
const fmt = n => Number(n).toFixed(2).replace(/\.00$/,'');
function renderParams(){
 const kind=$('kind').value; p=structuredClone(defaults[kind]); $('params').innerHTML='';
 $('paramCount').textContent=specs[kind].length+' PARAMETERS';
 specs[kind].forEach(([key,label,min,max,step])=>{
  const wrap=document.createElement('div');wrap.className='field';
  wrap.innerHTML=`<label>${label}<span class="value" id="v_${key}">${fmt(p[key])}</span></label><input class="range" id="p_${key}" type="range" min="${min}" max="${max}" step="${step}" value="${p[key]}">`;
  $('params').appendChild(wrap);
  $('p_'+key).addEventListener('input',e=>{p[key]=Number(e.target.value);$('v_'+key).textContent=fmt(p[key]);update()});
 });
 update();
}
function f(x,y){
 switch($('kind').value){
  case 'cd':return p.A*Math.pow(x,p.alpha)*Math.pow(y,p.beta);
  case 'ces':return Math.abs(p.rho)<1e-5?p.A*Math.pow(x,p.delta)*Math.pow(y,1-p.delta):p.A*Math.pow(p.delta*Math.pow(x,p.rho)+(1-p.delta)*Math.pow(y,p.rho),1/p.rho);
  case 'subs':return p.a*x+p.b*y;
  case 'comp':return Math.min(p.a*x,p.b*y);
  case 'quad':return p.c0+p.c1*x+p.c2*y+p.c3*x*x+p.c4*y*y+p.c5*x*y;
 }
}
// Native mathematical notation keeps the expression readable without a typesetting download.
function expression(){
 const number = value => {
  const n=Number(value.toFixed(10));
  return n<0?`<mrow><mo>−</mo><mn>${Math.abs(n)}</mn></mrow>`:`<mn>${n}</mn>`;
 };
 const variable = name => `<mi>${name}</mi>`;
 const power = (name,exponent) => exponent===1?variable(name):`<msup>${variable(name)}${number(exponent)}</msup>`;
 const product = (coefficient,factors) => `${coefficient===1&&factors?'':number(coefficient)}${factors}`;
 const sum = terms => {
  let result='';
  for(const [coefficient,factors] of terms){
   if(Math.abs(coefficient)<1e-10)continue;
   result+=coefficient<0?'<mo>−</mo>':result?'<mo>+</mo>':'';
   result+=product(Math.abs(coefficient),factors);
  }
  return result||'<mn>0</mn>';
 };
 const x=variable('x'),y=variable('y');
 let body;
 switch($('kind').value){
  case 'cd':body=product(p.A,power('x',p.alpha)+power('y',p.beta));break;
  case 'ces':
   if(Math.abs(p.rho)<1e-5){
    body=product(p.A,power('x',p.delta)+power('y',1-p.delta));
   }else{
    const inside=sum([[p.delta,power('x',p.rho)],[1-p.delta,power('y',p.rho)]]);
    body=product(p.A,`<msup><mrow><mo>(</mo>${inside}<mo>)</mo></mrow><mfrac><mn>1</mn>${number(p.rho)}</mfrac></msup>`);
   }
   break;
  case 'subs':body=sum([[p.a,x],[p.b,y]]);break;
  case 'comp':body=`<mi mathvariant="normal">min</mi><mo>(</mo>${product(p.a,x)}<mo>,</mo>${product(p.b,y)}<mo>)</mo>`;break;
  case 'quad':body=sum([[p.c0,''],[p.c1,x],[p.c2,y],[p.c3,power('x',2)],[p.c4,power('y',2)],[p.c5,x+y]]);break;
 }
 return `<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><mrow><mi>f</mi><mo>(</mo>${x}<mo>,</mo>${y}<mo>)</mo><mo>=</mo>${body}</mrow></math>`;
}

// Exact interior peak for the smooth family that can have a finite maximum.
function exactMaximum(){
 if($('kind').value!=='quad')return null;
 const a=2*p.c3,b=p.c5,c=2*p.c4,det=a*c-b*b;
 if(!(a<0&&det>0))return null;
 const x=(b*p.c2-c*p.c1)/det,y=(b*p.c1-a*p.c2)/det;
 return Number.isFinite(x)&&Number.isFinite(y)?{x,y}:null;
}
