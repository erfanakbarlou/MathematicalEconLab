let activeWorkspace='explorer',normsReady=false,normsResizeObserver=null,normsHeightFrame=0;
function resizeNormsFrame(){
 if(normsHeightFrame||activeWorkspace!=='norms')return;
 normsHeightFrame=requestAnimationFrame(()=>{
  normsHeightFrame=0;
  const frame=$('normsFrame'),body=frame.contentDocument?.body;if(!body)return;
  const height=Math.max(600,Math.ceil(body.getBoundingClientRect().height)+2);
  if(Math.abs(frame.getBoundingClientRect().height-height)>1)frame.style.height=height+'px';
 });
}
$('normsFrame').addEventListener('load',()=>{
 const frame=$('normsFrame'),body=frame.contentDocument?.body;if(!body)return;
 normsResizeObserver?.disconnect();
 normsResizeObserver=new ResizeObserver(resizeNormsFrame);normsResizeObserver.observe(body);
 resizeNormsFrame();
});
function selectWorkspace(workspace){
 const explorer=workspace==='explorer';
 if(activeWorkspace==='explorer')preserveLiveCamera($('surface'));
 activeWorkspace=workspace;
 $('explorerWorkspace').classList.toggle('hidden',!explorer);
 $('normsWorkspace').classList.toggle('hidden',explorer);
 document.querySelectorAll('[data-workspace]').forEach(button=>{
  const selected=button.dataset.workspace===workspace;button.classList.toggle('active',selected);
  if(selected)button.setAttribute('aria-current','page');else button.removeAttribute('aria-current');
 });
 if(!explorer){
  if(!normsReady){normsReady=true;$('normsFrame').srcdoc=JSON.parse($('normsDocument').textContent)}
  else requestAnimationFrame(()=>{$('normsFrame').contentWindow?.dispatchEvent(new Event('resize'));resizeNormsFrame()});
 }else requestAnimationFrame(()=>{
  // Resize the existing charts without recalculating data or resetting user state.
  preserveLiveCamera($('surface'));
  for(const id of ['surface','contour','slicePlot']){const plot=$(id);if(plot._fullLayout&&plot.getBoundingClientRect().width>0)Plotly.Plots.resize(plot)}
  paintDirectionArrow();
 });
}
document.querySelectorAll('[data-workspace]').forEach(button=>button.addEventListener('click',()=>selectWorkspace(button.dataset.workspace)));
const aboutDialog=$('aboutDialog');
let aboutBodyStyle=null;
$('navAbout').addEventListener('click',()=>{
 if(aboutDialog.open)return;
 // Keep the current workspace, scroll position and chart dimensions unchanged.
 const body=document.body,gap=window.innerWidth-document.documentElement.clientWidth;
 aboutBodyStyle={overflow:body.style.overflow,paddingRight:body.style.paddingRight};
 if(gap>0)body.style.paddingRight=(parseFloat(getComputedStyle(body).paddingRight)+gap)+'px';
 body.style.overflow='hidden';aboutDialog.showModal();
});
$('closeAbout').addEventListener('click',()=>aboutDialog.close());
aboutDialog.addEventListener('click',event=>{
 if(event.target!==aboutDialog)return;
 const rect=aboutDialog.getBoundingClientRect();
 if(event.clientX<rect.left||event.clientX>rect.right||event.clientY<rect.top||event.clientY>rect.bottom)aboutDialog.close();
});
aboutDialog.addEventListener('close',()=>{
 if(aboutBodyStyle){document.body.style.overflow=aboutBodyStyle.overflow;document.body.style.paddingRight=aboutBodyStyle.paddingRight;aboutBodyStyle=null}
});
