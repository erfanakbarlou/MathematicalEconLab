<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#090d18" />
<title>MathLab — Interactive Mathematical Economics</title>
<script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>
<style>
:root{--bg:#090d18;--panel:#111827;--panel2:#151f31;--line:#253249;--muted:#91a0b8;--text:#edf3ff;--accent:#8b7cff;--cyan:#55d6e8;--green:#66d9ad;--shadow:0 18px 55px #0005}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 80% -10%,#25204a 0,transparent 35%),var(--bg);color:var(--text);font:14px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif}
button,select,input{font:inherit}button{cursor:pointer}.app{min-height:100vh;display:grid;grid-template-columns:248px 1fr}
.sidebar{background:#0b1120cc;border-right:1px solid var(--line);padding:25px 17px;display:flex;flex-direction:column;gap:28px}
.brand{display:flex;align-items:center;gap:11px;padding:2px 8px}.brand-mark{width:38px;height:38px;border-radius:12px;background:linear-gradient(135deg,#8c7cff,#4ccfe0);display:grid;place-items:center;color:#07101b;font-weight:900;font-size:20px;box-shadow:0 8px 24px #7668ff55}.brand strong{font-size:17px;letter-spacing:.2px}.brand small{display:block;color:var(--muted);font-size:10px;letter-spacing:1.5px;text-transform:uppercase}
.nav-label{font-size:10px;text-transform:uppercase;letter-spacing:1.5px;color:#687994;padding:0 10px;margin-bottom:8px}.nav-item{width:100%;display:flex;align-items:center;gap:11px;padding:11px 12px;border:1px solid transparent;background:transparent;color:#aab7cc;border-radius:10px;text-align:left;margin:3px 0}.nav-item.active{background:linear-gradient(100deg,#7164db28,#4acde20d);border-color:#7164db55;color:white}.nav-icon{width:20px;text-align:center;font-size:16px}.side-note{margin-top:auto;border:1px solid var(--line);background:#111a2b;border-radius:10px;padding:11px 8px;color:var(--muted);font-size:10px;letter-spacing:.5px;text-align:center;white-space:nowrap}
main{min-width:0;padding:28px clamp(18px,3vw,44px) 50px;max-width:1800px;width:100%;margin:auto}.topbar{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:27px}.eyebrow{color:var(--cyan);font-size:11px;text-transform:uppercase;letter-spacing:1.8px;font-weight:700}.topbar h1{font-size:clamp(25px,3vw,34px);line-height:1.15;margin:6px 0 8px;letter-spacing:-1px}.subtitle{color:var(--muted);margin:0}.top-actions{display:flex;gap:9px}.ghost,.primary{border:1px solid var(--line);border-radius:10px;padding:9px 13px;background:#111a2b;color:#dce6fa}.primary{background:linear-gradient(120deg,#8070ef,#4a9fca);border:0;color:white;font-weight:700}
.layout{display:grid;grid-template-columns:minmax(260px,315px) minmax(0,1fr);gap:18px;align-items:start}.panel,.chart-card,.metric{background:linear-gradient(145deg,#141e30,#101827);border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow)}.panel{padding:19px;position:static}.section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:15px}.section-head h2,.chart-head h2{font-size:14px;margin:0;font-weight:700}.tag{font-size:10px;color:var(--green);background:#66d9ad17;border:1px solid #66d9ad35;padding:4px 8px;border-radius:20px}
.field{margin:15px 0}.field label{display:flex;justify-content:space-between;gap:10px;color:#c8d3e7;font-size:12px;margin-bottom:8px}.value{color:var(--cyan);font-variant-numeric:tabular-nums;font-weight:700}.select{width:100%;background:#0b1322;color:#edf3ff;border:1px solid #30405b;border-radius:9px;padding:11px;outline:none}.range{width:100%;accent-color:#8b7cff}.point-toggle{display:flex;align-items:center;gap:8px;color:#c8d3e7;font-size:12px;margin:10px 0}.point-toggle input,.infinity-toggle input{accent-color:#8b7cff}.manual-row{display:flex;align-items:center;gap:8px}.manual-number{width:100%;min-width:0;background:#0b1322;border:1px solid #30405b;border-radius:8px;padding:7px 9px;color:var(--text);font:inherit;font-size:12px}.infinity-toggle{display:flex;align-items:center;gap:4px;color:var(--cyan);font-size:12px}.infinity-note{font-size:10px;color:#f4c779;margin-top:4px}.hint{font-size:11px;color:#7889a4;margin-top:5px}.divider{height:1px;background:var(--line);margin:18px 0}.field-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.field-grid .field{margin:9px 0}.field-grid input[type=number]{width:100%;background:#0b1322;border:1px solid #30405b;border-radius:8px;padding:8px;color:var(--text)}
.content{min-width:0}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:15px}.metric{padding:13px 15px}.metric span{display:block;color:var(--muted);font-size:11px}.metric strong{display:block;font-size:19px;margin-top:4px;font-variant-numeric:tabular-nums}
.chart-card{padding:17px;margin-bottom:15px;min-width:0}.chart-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:8px}.chart-head p{margin:4px 0 0;color:var(--muted);font-size:11px}.chart-badge{font-size:10px;color:#b8b0ff;background:#8b7cff19;border:1px solid #8b7cff44;padding:4px 8px;border-radius:20px;white-space:nowrap}
.charts{display:grid;grid-template-columns:1.15fr .85fr;gap:15px}.plot{height:420px;width:100%}.plot.small{height:390px}
.formula{background:#0b1423;border:1px solid #273851;border-radius:12px;padding:16px 18px;margin-bottom:15px;overflow:auto}.formula-head{color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:1.4px;margin-bottom:8px}.equation{font-size:18px;color:#e9e8ff;min-height:30px}.footnote{font-size:11px;color:#8595ae;margin-top:10px}
.info{display:grid;grid-template-columns:1fr 1fr;gap:12px}.info-card{padding:15px 17px;border:1px solid var(--line);border-radius:13px;background:#101827}.info-card h3{font-size:12px;margin:0 0 7px}.info-card p{font-size:12px;color:var(--muted);margin:0}

.analysis-panel{background:linear-gradient(145deg,#141e30,#101827);border:1px solid var(--line);border-radius:16px;padding:18px;margin-top:15px;box-shadow:var(--shadow)}
.analysis-top{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:13px}
.analysis-top h2{font-size:14px;margin:0}.analysis-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.matrix-card{background:#0b1423;border:1px solid #273851;border-radius:12px;padding:13px;min-width:0}
.matrix-card h3{font-size:12px;margin:0 0 8px;color:#dce6fa}.matrix{display:flex;align-items:center;gap:7px;overflow-x:auto;padding:5px 0}
.matrix-bracket{font-family:Georgia,serif;font-size:38px;color:#8b7cff;line-height:1}
.matrix-values{display:grid;gap:5px;text-align:center;font-variant-numeric:tabular-nums;color:#d8e5f8;font-size:12px;white-space:nowrap}
.matrix-values span{background:#18243a;padding:5px 8px;border-radius:5px;min-width:65px}
.classification{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin-top:12px}
.class-item{padding:11px 12px;border-radius:10px;background:#0b1423;border:1px solid #273851}
.class-item span{display:block;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:1px}
.class-item b{display:block;margin-top:4px;font-size:13px;color:#dfe8f8}
.class-item b.good{color:#66d9ad}.class-item b.warn{color:#f4c779}.class-item b.bad{color:#ff9292}
.analysis-note{font-size:11px;color:#8595ae;line-height:1.6;margin:12px 2px 0}
@media(max-width:1050px){.analysis-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:760px){.analysis-grid,.classification{grid-template-columns:1fr}}
.hidden{display:none!important}.mobile-menu{display:none}
@media(max-width:1050px){.layout{grid-template-columns:270px minmax(0,1fr)}.charts{grid-template-columns:1fr}.plot,.plot.small{height:390px}}
@media(max-width:760px){.app{grid-template-columns:1fr}.sidebar{display:none}.mobile-menu{display:inline-flex}.layout{grid-template-columns:1fr}.panel{position:static}.topbar{align-items:flex-start}.top-actions .ghost{display:none}.metrics{grid-template-columns:1fr 1fr}.metrics .metric:last-child{grid-column:span 2}.plot,.plot.small{height:340px}main{padding:20px 14px 35px}}
.analysis-panel .analysis-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
.analysis-panel .analysis-top{padding-bottom:14px;border-bottom:1px solid #253249;margin-bottom:18px}
.analysis-panel .matrix-card{background:linear-gradient(145deg,#0d1729,#0a1220);border-color:#30415e;padding:16px;box-shadow:inset 0 1px 0 #ffffff08}
.analysis-panel .matrix{justify-content:center;min-height:78px;gap:8px;overflow:hidden}
.analysis-panel .matrix-values span{min-width:58px;padding:6px 8px}
.analysis-panel .analysis-note{padding:11px 13px;border-left:2px solid #7164db;background:#0b1423;border-radius:0 8px 8px 0}
@media(max-width:760px){.analysis-panel .analysis-grid{grid-template-columns:1fr}}.chart-actions{display:flex;align-items:center;gap:8px}.fullscreen-toggle{width:34px;height:30px;border:1px solid #30405b;border-radius:8px;background:#0b1322;color:#dce6fa;font-size:18px;cursor:pointer}.chart-card:fullscreen{width:100vw;height:100vh;margin:0;padding:20px;display:flex;flex-direction:column;background:#090d18}.chart-card:fullscreen .plot{height:calc(100vh - 100px)!important;flex:1}
.chart-card{position:relative}
.gradient-peek{position:absolute;z-index:5;top:66px;right:18px;display:none;min-width:190px;padding:10px 12px;border:1px solid #465878;border-radius:10px;background:#0b1322ed;box-shadow:0 10px 30px #0008;pointer-events:none;font-size:11px}
.gradient-peek.visible{display:block}.gradient-peek-title{color:#aebbd0;margin-bottom:6px;font-size:10px;letter-spacing:.3px}.gradient-peek-row{display:flex;justify-content:space-between;gap:14px;padding:2px 0}.gradient-peek-row b{font-variant-numeric:tabular-nums}.gradient-peek-row .positive{color:#66d9ad}.gradient-peek-row .negative{color:#ff9292}.gradient-peek-row .flat{color:#f4c779}
.equation{direction:ltr;text-align:left;overflow-x:auto;padding:6px 0;font-size:clamp(20px,2.2vw,26px)}
.equation math{display:block;width:max-content;min-width:0;margin:0;font-family:"Cambria Math","STIX Two Math",math}

.slice-menu{position:absolute;z-index:12;max-width:260px;padding:12px;background:#101b2eee;border:1px solid #55d6e877;border-radius:12px;box-shadow:0 12px 35px #0008}.slice-menu p{margin:0 0 9px;color:#cad8eb;font-size:12px}.slice-buttons{display:flex;gap:7px;flex-wrap:wrap}.slice-buttons button{border:1px solid #3a5671;border-radius:8px;padding:7px 10px;background:#172b41;color:#edf3ff}.slice-buttons button.active{border-color:#55d6e8;color:#55d6e8}.slice-card{border-color:#55d6e855}.slice-card.reveal{animation:sliceReveal .45s ease-out}.slice-caption{color:#91a0b8;font-size:12px;margin:6px 0 0}.slice-plot{width:100%;height:330px}@keyframes sliceReveal{from{opacity:0;transform:translateY(-14px)}to{opacity:1;transform:translateY(0)}}@media(prefers-reduced-motion:reduce){.slice-card.reveal{animation:none}}
.direction-controls{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:12px 0}.direction-controls input[type=range]{flex:1;min-width:120px;accent-color:#c29aff}.direction-controls input[type=number]{width:85px}.direction-result{padding:10px 12px;background:#0b1423;border:1px solid #594879;border-radius:9px;color:#dccbff;font-variant-numeric:tabular-nums}.direction-overlay{position:absolute;inset:0;width:100%;height:100%;z-index:8;pointer-events:none;overflow:hidden}
.norms-workspace{min-width:0;width:100%;align-self:start;background:#090e1a}.mobile-workspace-switch{display:none}@media(max-width:760px){.mobile-workspace-switch{display:flex;gap:8px;padding:12px 14px;border-bottom:1px solid var(--line)}.mobile-workspace-switch button{border:1px solid var(--line);border-radius:9px;background:#111a2b;color:var(--text);padding:8px 12px}.mobile-workspace-switch button[aria-current=page]{border-color:var(--accent);background:#8b7cff22}}

.about-dialog{width:min(650px,calc(100vw - 32px));max-height:calc(100dvh - 40px);margin:auto;padding:44px 46px 25px;overflow-y:auto;overscroll-behavior:contain;color:var(--text);border:1px solid #8b7cff55;border-radius:24px;background:radial-gradient(ellipse at 5% 0%,#34305b80,transparent 55%),linear-gradient(150deg,#182238,#0d1525);box-shadow:0 30px 100px #0009,inset 0 1px 0 #ffffff12}.about-dialog::backdrop{background:#040812b8;backdrop-filter:blur(7px)}.about-dialog[open]{animation:aboutEnter .25s ease-out}.about-close{position:absolute;top:17px;right:18px;width:34px;height:34px;display:grid;place-items:center;padding:0;border:1px solid #ffffff18;border-radius:50%;background:#ffffff05;color:#aebbd0;font-size:24px;line-height:1}.about-close:hover{color:#fff;background:#ffffff12}.about-close:focus-visible{outline:2px solid var(--cyan);outline-offset:3px}.about-symbol{width:48px;height:48px;display:grid;place-items:center;border-radius:15px;background:linear-gradient(140deg,#8b7cff2b,#55d6e811);border:1px solid #a99aff44;color:#c9beff;font-family:Georgia,serif;font-size:27px;margin-bottom:23px}.about-eyebrow{color:#9f94ee;letter-spacing:2.2px;font-size:10px;font-weight:700}.about-dialog h2{margin:11px 0 20px;font-size:clamp(27px,4.5vw,39px);font-weight:600;letter-spacing:-1.1px;line-height:1.19}.about-rule{height:2px;width:55px;background:linear-gradient(90deg,#a394ff,#55d6e8);margin-bottom:24px}.about-copy p{color:#aebbd0;font-size:14px;line-height:1.85;margin:0 0 16px}.about-footer{display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;border-top:1px solid #ffffff10;padding-top:18px;margin-top:28px;font-size:9px;letter-spacing:1.5px;color:#7e8ca5}.about-footer span:first-child{color:#b7afd9;font-weight:700}@keyframes aboutEnter{from{opacity:0;transform:translateY(12px) scale(.98)}to{opacity:1;transform:none}}@media(max-width:600px){.about-dialog{padding:32px 25px 22px}.about-copy p{font-size:13px}}@media(prefers-reduced-motion:reduce){.about-dialog[open]{animation:none}}
</style>
</head>
<body>
<div class="app">
<nav class="mobile-workspace-switch" aria-label="Workspace"><button type="button" data-workspace="explorer" aria-current="page">Function Explorer</button><button type="button" data-workspace="norms">Norm Lab</button></nav>
<aside class="sidebar">
  <div class="brand"><div class="brand-mark">∑</div><div><strong>MathLab</strong><small>Economics in motion</small></div></div>
  <div><div class="nav-label">Workspace</div>
    <button class="nav-item active" id="navExplorer" data-workspace="explorer" aria-current="page"><span class="nav-icon">◈</span> Function Explorer</button>
    <button class="nav-item" id="navNorms" data-workspace="norms"><span class="nav-icon">‖·‖</span> Norm Lab</button>
    <button class="nav-item" id="navAbout" aria-haspopup="dialog" aria-controls="aboutDialog"><span class="nav-icon">ⓘ</span> About this lab</button>
  </div>
  <div class="side-note">VERSION 1.0 · WEB APPLICATION</div>
</aside>
<main id="explorerWorkspace">
  <header class="topbar">
    <div><div class="eyebrow">Mathematical economics / Visualization studio</div><h1>Function Explorer</h1><p class="subtitle">Explore multivariable functions through interactive 3D surfaces and level sets.</p></div>
    <div class="top-actions"><button class="ghost" id="reset">↺ Reset</button><button class="primary" id="export">↓ Export chart</button></div>
  </header>
  <div class="layout">
    <section class="panel">
      <div class="section-head"><h2>Function settings</h2><span class="tag">LIVE MODEL</span></div>
      <div class="field"><label for="kind">Function family</label><select class="select" id="kind">
        <option value="cd">Cobb–Douglas</option><option value="ces">CES</option><option value="subs">Perfect Substitutes</option><option value="comp">Perfect Complements</option><option value="quad">Quadratic</option>
      </select></div>
      <div class="divider"></div>
      <div class="section-head"><h2>Parameters</h2><span class="chart-badge" id="paramCount">3 PARAMETERS</span></div>
      <div id="params"></div>
      <div class="divider"></div>
      <div class="section-head"><h2>Domain & point</h2></div><label class="point-toggle"><input id="pointEnabled" type="checkbox" checked> Select a point</label>
      <div class="field"><label>Maximum x <span class="value" id="xmaxVal">10</span></label><div class="manual-row"><input class="manual-number" id="xmaxInput" type="number" min="3" step="any" value="10" aria-label="Maximum x value"><label class="infinity-toggle"><input id="xInfinity" type="checkbox"> ∞</label></div><input class="range" id="xmax" type="range" min="3" max="20" step="1" value="10"></div>
      <div class="field"><label>Maximum y <span class="value" id="ymaxVal">10</span></label><div class="manual-row"><input class="manual-number" id="ymaxInput" type="number" min="3" step="any" value="10" aria-label="Maximum y value"><label class="infinity-toggle"><input id="yInfinity" type="checkbox"> ∞</label></div><input class="range" id="ymax" type="range" min="3" max="20" step="1" value="10"></div>
      <div class="field-grid">
        <div class="field"><label>x₀ <span class="value" id="x0Val">4</span></label><input class="manual-number" id="x0Input" type="number" min=".2" step="any" value="4" aria-label="Selected x value"><input class="range" id="x0" type="range" min=".2" max="10" step=".1" value="4"></div>
        <div class="field"><label>y₀ <span class="value" id="y0Val">4</span></label><input class="manual-number" id="y0Input" type="number" min=".2" step="any" value="4" aria-label="Selected y value"><input class="range" id="y0" type="range" min=".2" max="10" step=".1" value="4"></div>
      </div>
      <div class="field"><label for="surfaceStyle">3D surface appearance</label><select class="select" id="surfaceStyle"><option value="original">Original · Color</option><option value="opaque">Opaque · Pearl white</option></select></div>
      <div class="field"><label>Number of level curves <span class="value" id="levelsVal">8</span></label><input class="range" id="levels" type="range" min="3" max="15" step="1" value="8"></div>
      <p class="hint">All plots update automatically when a setting changes.</p>
    </section>
    <section class="content">
      <div class="metrics">
        <div class="metric"><span>Selected point</span><strong id="pointMetric">(4.0, 4.0)</strong></div>
        <div class="metric"><span>Function value · f(x₀, y₀)</span><strong id="zMetric">4.000</strong></div>
        <div class="metric"><span>Regularity</span><strong id="smoothMetric" style="font-size:16px">Smooth</strong></div>
      </div>
      <div class="formula"><div class="formula-head">Current mathematical expression</div><div class="equation" id="formula" aria-live="polite"></div><div class="footnote" id="formulaNote">A multiplicative production or utility function with positive inputs.</div></div>
      <div class="charts">
        <div class="chart-card"><div class="chart-head"><div><h2>3D Function Surface</h2><p>Drag to rotate · Scroll to zoom · Level sets projected on the base</p></div><div class="chart-actions"><span class="chart-badge">SURFACE</span><button type="button" class="ghost hidden" id="clearSlice" title="Remove cross-section">Remove cut ×</button><button class="fullscreen-toggle" type="button" title="Fullscreen" aria-label="Fullscreen">⛶</button></div></div><div id="surface" class="plot"></div><p class="hint">Right-click the surface to lock a point and choose an x or y cross-section.</p><div id="sliceMenu" class="slice-menu hidden"><p id="sliceMenuPoint"></p><div class="slice-buttons"><button type="button" data-slice-axis="x">Along x · fixed y</button><button type="button" data-slice-axis="y">Along y · fixed x</button><button type="button" data-slice-axis="dir">Directional</button><button type="button" id="sliceMenuCancel" aria-label="Close slice menu">×</button></div></div><div class="gradient-peek" id="surfaceGradientPeek"></div></div>
        <div class="chart-card"><div class="chart-head"><div><h2>Level Sets</h2><p>Drag to pan · Zoom controls disabled · Hover for coordinates</p></div><div class="chart-actions"><span class="chart-badge">CONTOUR</span><button class="fullscreen-toggle" type="button" title="Fullscreen" aria-label="Fullscreen">⛶</button></div></div><div id="contour" class="plot small"></div><svg id="directionOverlay" class="direction-overlay hidden" aria-label="Direction of cross-section"><defs><marker id="directionArrowhead" markerWidth="9" markerHeight="9" refX="7" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8" fill="none" stroke="#c29aff" stroke-width="1.8"/></marker></defs><line id="directionArrow" stroke="#c29aff" stroke-width="3" marker-end="url(#directionArrowhead)"/><circle id="directionOrigin" r="4" fill="#c29aff"/><circle id="directionHandle" r="10" fill="#c29aff" fill-opacity="0.35" stroke="#eadbff" stroke-width="2" style="pointer-events:all;cursor:grab;touch-action:none"/></svg><div class="gradient-peek" id="contourGradientPeek"></div></div>
      </div>
      <section class="chart-card slice-card hidden" id="sliceCard"><div class="chart-head"><div><h2 id="sliceTitle">2D Cross-section</h2><p id="sliceDescription"></p></div><div class="slice-buttons"><button type="button" data-slice-axis="x" id="sliceAlongX">Along x</button><button type="button" data-slice-axis="y" id="sliceAlongY">Along y</button><button type="button" data-slice-axis="dir" id="sliceDirectional">Directional</button><button type="button" id="sliceClose" aria-label="Close cross-section">×</button></div></div><div id="directionControls" class="hidden"><div class="direction-controls"><label for="directionAngle">Direction θ</label><input id="directionAngle" type="range" min="0" max="360" step="1" value="45"><input id="directionAngleNumber" class="manual-number" type="number" min="0" max="360" step="any" value="45" aria-label="Direction angle in degrees"><span>°</span></div><p class="hint">0° = +x · 90° = +y · Drag the purple arrow tip on Level Sets to rotate.</p><p id="directionResult" class="direction-result" aria-live="polite"></p></div><div id="slicePlot" class="slice-plot"></div></section>
      <div class="info">
        <div class="info-card"><h3>How to read the surface</h3><p>The vertical axis represents the function value. The highlighted marker identifies the selected input bundle (x₀, y₀).</p></div>
        <div class="info-card"><h3>How to read level sets</h3><p>Each contour connects input combinations that produce the same value of f(x, y). Move the selected point to inspect its function value.</p></div>
      </div>
      <section class="analysis-panel" id="analysis">
        <div class="analysis-top"><h2>Differential & curvature analysis</h2><span class="chart-badge">SYMBOLIC STRUCTURE · NUMERICAL EVALUATION</span></div>
        <div class="analysis-grid">
