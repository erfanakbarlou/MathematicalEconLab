rms.\\u003c/h1\u003e\\u003cp class=\\\"lead\\\"\u003eChoose p, move two points, and explore the geometry of the general Lp norm in two and three dimensions.\\u003c/p\u003e\\u003c/header\u003e\\n\\u003csection id=\\\"shapes\\\"\u003e\\u003ch2\u003eThe general Lp norm\\u003c/h2\u003e\\u003cdiv class=\\\"formula\\\"\u003e\u2016x\u2016\\u003csub\u003ep\\u003c/sub\u003e = (\u2211\\u003csub\u003ei=1\\u003c/sub\u003e\\u003csup\u003en\\u003c/sup\u003e |x\\u003csub\u003ei\\u003c/sub\u003e|\\u003csup\u003ep\\u003c/sup\u003e)\\u003csup\u003e1/p\\u003c/sup\u003e, \u0026nbsp; 1 \u2264 p \u0026lt; \u221e\\u003c/div\u003e\\u003cdiv class=\\\"formula\\\"\u003ed\\u003csub\u003ep\\u003c/sub\u003e(A, B) = (\u2211\\u003csub\u003ei=1\\u003c/sub\u003e\\u003csup\u003en\\u003c/sup\u003e |B\\u003csub\u003ei\\u003c/sub\u003e \u2212 A\\u003csub\u003ei\\u003c/sub\u003e|\\u003csup\u003ep\\u003c/sup\u003e)\\u003csup\u003e1/p\\u003c/sup\u003e\\u003c/div\u003e\\u003cp\u003ep = 1 gives the sum norm; p = 2 gives the Euclidean norm. As p tends to infinity, the norm tends to max |x\u1d62|. Select \u221e for the exact sup norm.\\u003c/p\u003e\\u003cp class=\\\"note\\\"\u003eEach playground has its own p and point controls. This section uses p \u2265 1; for 0 \u0026lt; p \u0026lt; 1 the expression is a quasi-norm, not a norm.\\u003c/p\u003e\\u003c/section\u003e\\u003csection id=\\\"lab2\\\"\u003e\\u003ch2\u003eExplore in two dimensions\\u003c/h2\u003e\\u003cp\u003eDrag A or B on the plane, or enter their coordinates. The selected ball is centered at A and passes through B.\\u003c/p\u003e\\u003cdiv class=\\\"lab\\\" id=\\\"two\\\"\u003e\\u003c/div\u003e\\u003c/section\u003e\\n\\u003csection id=\\\"lab3\\\"\u003e\\u003ch2\u003eExplore in three dimensions\\u003c/h2\u003e\\u003cp\u003eChange the coordinates to move A and B. Drag the scene to orbit; scroll to zoom. Your viewing angle stays fixed as you change the norm or points.\\u003c/p\u003e\\u003cdiv class=\\\"lab\\\" id=\\\"three\\\"\u003e\\u003c/div\u003e\\u003c/section\u003e\\u003cfooter\u003eDistance is d(A, B) = \u2016B \u2212 A\u2016. The straight segment joins the same two points for every norm; its norm-based length changes.\\u003cbr\u003eDisplayed values are rounded; \u2248 marks approximate equality. Curved boundaries are sampled for drawing; distances are calculated from the norm formula.\\u003c/footer\u003e\\u003c/main\u003e\\n\\u003cscript\u003e\\n'use strict';\\nconst defs=[{id:'2',name:'Euclidean',short:'L\u2082',color:'#ad9bff',formula:'\u2016x\u2016\u2082 = \u221a(x\u2081\u00b2 + \u22ef + x\u2099\u00b2)',shape2:'Circle',shape3:'Sphere'}, {id:'1',name:'Sum',short:'L\u2081',color:'#56d9e8',formula:'\u2016x\u2016\u2081 = |x\u2081| + \u22ef + |x\u2099|',shape2:'Diamond',shape3:'Octahedron'}, {id:'inf',name:'Sup',short:'L\u221e',color:'#ffbb70',formula:'\u2016x\u2016\u221e = max(|x\u2081|, \u2026, |x\u2099|)',shape2:'Square',shape3:'Cube'}];\\nconst fmt=n=\u003en===0?'0':Math.abs(n)\\u003c0.001?Number(n.toPrecision(3)).toString():Number(n.toFixed(3)).toString();\\nconst relation=n=\u003eNumber(fmt(n))===n?' = ':' \u2248 ';\\nfunction norm(v,k){const m=Math.max(...v.map(Math.abs));if(m===0)return 0;if(k==='inf')return m;const q=Number(k);return m*Math.pow(v.reduce((s,x)=\u003es+Math.pow(Math.abs(x)/m,q),0),1/q);}\\nfunction spow(x,q){return Math.abs(x)\\u003c1e-14?0:Math.sign(x)*Math.pow(Math.abs(x),q);}\\nfunction mesh(k){if(k==='inf'){const v=[];for(let x of [-1,1])for(let y of [-1,1])for(let z of [-1,1])v.push([x,y,z]);return [[0,1,3,2],[4,6,7,5],[0,4,5,1],[2,3,7,6],[0,2,6,4],[1,5,7,3]].map(f=\u003ef.map(i=\u003ev[i]));}if(k==='1'){const f=[];for(let x of [-1,1])for(let y of [-1,1])for(let z of [-1,1])f.push([[x,0,0],[0,y,0],[0,0,z]]);return f;}const f=[],N=48,M=24,q=2/Number(k);const p=(a,b)=\u003e[spow(Math.sin(b),q)*spow(Math.cos(a),q),spow(Math.sin(b),q)*spow(Math.sin(a),q),spow(Math.cos(b),q)];for(let j=0;j\\u003cM;j++)for(let i=0;i\\u003cN;i++)f.push([p(i*2*Math.PI/N,j*Math.PI/M),p((i+1)*2*Math.PI/N,j*Math.PI/M),p((i+1)*2*Math.PI/N,(j+1)*Math.PI/M),p(i*2*Math.PI/N,(j+1)*Math.PI/M)]);return f;}\\nlet cachedKey=null,cachedMesh=null;function getMesh(k){if(cachedKey!==k){cachedKey=k;cachedMesh=mesh(k);}return cachedMesh;}\\nfunction setup(c){const r=c.getBoundingClientRect(),d=devicePixelRatio||1;if(c.width!==Math.round(r.width*d)||c.height!==Math.round(r.height*d)){c.width=Math.round(r.width*d);c.height=Math.round(r.height*d);}const g=c.getContext('2d');g.setTransform(d,0,0,d,0,0);g.clearRect(0,0,r.width,r.height);return {g,w:r.width,h:r.height};}\\nfunction line(g,pts,color,width=1,dash=[]){g.beginPath();pts.forEach((p,i)=\u003ei?g.lineTo(p[0],p[1]):g.moveTo(p[0],p[1]));g.strokeStyle=color;g.lineWidth=width;g.setLineDash(dash);g.stroke();g.setLineDash([]);}\\nfunction text(g,s,p,color='#9caec9'){g.fillStyle=color;g.font='13px system-ui';g.fillText(s,p[0],p[1]);}\\nfunction path2(k){if(k==='1')return [[1,0],[0,1],[-1,0],[0,-1]];if(k==='inf')return [[1,1],[-1,1],[-1,-1],[1,-1]];return Array.from({length:240},(_,i)=\u003e[spow(Math.cos(i*Math.PI/120),2/Number(k)),spow(Math.sin(i*Math.PI/120),2/Number(k))]);}\\nfunction ball2(g,k,p,r,project,color){const v=path2(k).map(q=\u003eproject([p[0]+r*q[0],p[1]+r*q[1]]));g.beginPath();v.forEach((q,i)=\u003ei?g.lineTo(...q):g.moveTo(...q));g.closePath();g.fillStyle=color+'18';g.fill();g.strokeStyle=color;g.lineWidth=2;g.stroke();}\\nfunction projection(w,h,extent,yaw,pitch,zoom=1){const scale=Math.min(w,h)*.28/extent*zoom;return p=\u003e{const x=Math.cos(yaw)*p[0]-Math.sin(yaw)*p[1],y=Math.sin(yaw)*p[0]+Math.cos(yaw)*p[1];return [w/2+scale*x,h/2-scale*(Math.cos(pitch)*p[2]-Math.sin(pitch)*y),Math.sin(pitch)*p[2]+Math.cos(pitch)*y];};}\\nfunction ball3(g,k,a,r,project,color){const faces=getMesh(k).map(f=\u003ef.map(v=\u003eproject(v.map((x,i)=\u003ea[i]+x*r))));faces.sort((a,b)=\u003ea.reduce((s,p)=\u003es+p[2],0)/a.length-b.reduce((s,p)=\u003es+p[2],0)/b.length);for(const f of faces){g.beginPath();f.forEach((p,i)=\u003ei?g.lineTo(p[0],p[1]):g.moveTo(p[0],p[1]));g.closePath();g.fillStyle=color+(k!=='1'\u0026\u0026k!=='inf'?'0b':'18');g.fill();g.strokeStyle=color+(k!=='1'\u0026\u0026k!=='inf'?'32':'99');g.lineWidth=.7;g.stroke();}}\\nfunction createLab(id,dim){const root=document.getElementById(id),s={dim,k:'2',a:Array(dim).fill(0),b:dim===2?[3,4]:[2,3,4],yaw:.65,pitch:.5,zoom:1,ball:true};root.innerHTML=`\\u003caside\u003e\\u003cdiv class=\\\"eyebrow\\\"\u003eChoose p\\u003c/div\u003e\\u003cdiv class=\\\"tabs\\\"\u003e${['1','2','4','inf'].map(k=\u003e`\\u003cbutton data-k=\\\"${k}\\\" aria-pressed=\\\"${k==='2'}\\\"\u003e${k==='inf'?'\u221e':'p = '+k}\\u003c/button\u003e`).join('')}\\u003c/div\u003e\\u003clabel for=\\\"p-${id}\\\"\u003eCustom p (p \u2265 1)\\u003c/label\u003e\\u003cdiv style=\\\"display:flex;gap:10px;margin:10px 0\\\"\u003e\\u003cinput id=\\\"p-${id}\\\" class=\\\"p-number\\\" type=\\\"number\\\" min=\\\"1\\\" step=\\\"any\\\" value=\\\"2\\\" style=\\\"width:100%\\\" aria-label=\\\"Custom p for ${dim}D\\\"\u003e\\u003c/div\u003e\\u003cinput class=\\\"p-range\\\" type=\\\"range\\\" min=\\\"1\\\" max=\\\"20\\\" step=\\\"0.05\\\" value=\\\"2\\\" aria-label=\\\"p slider for ${dim}D\\\"\u003e\\u003cp class=\\\"note\\\"\u003eSlider: 1\u201320. Enter any finite p \u2265 1 above, or select \u221e.\\u003c/p\u003e\\u003cp class=\\\"p-error\\\" role=\\\"status\\\" style=\\\"color:#ffbb70;font-size:14px\\\"\u003e\\u003c/p\u003e\\u003cdiv class=\\\"controls\\\"\u003e\\u003c/div\u003e\\u003clabel class=\\\"check\\\"\u003e\\u003cinput type=\\\"checkbox\\\" checked\u003e Show distance ball\\u003c/label\u003e\\u003cbutton class=\\\"reset\\\"\u003eReset points\\u003c/button\u003e\\u003cp class=\\\"note\\\"\u003eCoordinate range: \u22125 to 5.\\u003cbr\u003e${dim===2?'Drag either colored point.':'Use sliders or numeric inputs to move points.'}\\u003c/p\u003e\\u003c/aside\u003e\\u003cdiv class=\\\"workspace\\\"\u003e\\u003cdiv class=\\\"status\\\"\u003e\\u003cstrong\u003e${dim}D distanc